{% liquid
  assign logo = section.settings.logo
  assign announcement_text = section.settings.announcement_text
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
%}

<section
  id="tisso-header-{{ section.id }}"
  class="tisso-header"
  style="
    --header-height: {{ section.settings.header_height }}px;
    --header-padding: {{ section.settings.horizontal_padding }}px;
    --logo-width: {{ section.settings.logo_width }}px;

    --header-bg: {{ section.settings.header_bg }};
    --text-color: {{ section.settings.text_color }};
    --message-font: 'Jost', 'Helvetica Neue', Arial, sans-serif;

    --button-bg: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text_color }};

    --button-hover-bg: {{ section.settings.button_hover_bg }};
    --button-hover-text: {{ section.settings.button_hover_text }};

    --button-width: {{ section.settings.button_width }}px;
  "
>
  <div class="tisso-header__inner">
    <button type="button" class="tisso-header__menu-toggle" aria-label="Open menu" aria-expanded="false" data-tisso-menu-toggle>
      <span></span><span></span><span></span>
    </button>

    <!-- LOGO -->
    <div class="tisso-header__logo">
      {% if logo != blank %}
        <a href="{{ routes.root_url }}" class="tisso-header__logo-link">
          {{
            logo
            | image_url: width: 500
            | image_tag:
              widths: '200, 300, 400, 500',
              loading: 'eager',
              class: 'tisso-header__logo-image',
              alt: logo.alt | default: shop.name
          }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="tisso-header__logo-link">
          <img
            src="{{ 'custom-logo.svg' | asset_url }}"
            class="tisso-header__logo-image"
            width="{{ section.settings.logo_width }}"
            height="40"
            alt="{{ shop.name | escape }}"
          >
        </a>
      {% endif %}
    </div>

    <!-- CENTER TEXT -->
    <div class="tisso-header__message">
      {{ announcement_text }}
    </div>

    <!-- BUTTON -->
    <div class="tisso-header__action">
      {% if button_url != blank %}
        <a
          href="{{ button_url }}"
          class="tisso-header__button"
        >
          <span class="tisso-header__button-text">
            {{ button_text }}
          </span>

          <span class="tisso-header__button-arrow" aria-hidden="true">
            <img class="tisso-header__button-arrow--black" src="{{ 'black-arrow.svg' | asset_url }}" width="27" height="12" alt="">
            <img class="tisso-header__button-arrow--white" src="{{ 'white-arrow.svg' | asset_url }}" width="27" height="12" alt="">
          </span>
        </a>
      {% else %}
        <button
          type="button"
          class="tisso-header__button"
        >
          <span class="tisso-header__button-text">
            {{ button_text }}
          </span>

          <span class="tisso-header__button-arrow" aria-hidden="true">
            <img class="tisso-header__button-arrow--black" src="{{ 'black-arrow.svg' | asset_url }}" width="27" height="12" alt="">
            <img class="tisso-header__button-arrow--white" src="{{ 'white-arrow.svg' | asset_url }}" width="27" height="12" alt="">
          </span>
        </button>
      {% endif %}
    </div>

  </div>

  <div class="tisso-header__mobile-panel" data-tisso-mobile-panel hidden>
    <div class="tisso-header__mobile-panel-bar">
      <button type="button" class="tisso-header__mobile-close" aria-label="Close menu" data-tisso-menu-close>×</button>
      <span>TISSO VISION</span>
    </div>
    <p>{{ announcement_text }}</p>
    {% if button_url != blank %}
      <a href="{{ button_url }}" class="tisso-header__button tisso-header__mobile-button">
        <span class="tisso-header__button-text">{{ button_text }}</span>
        <span class="tisso-header__button-arrow" aria-hidden="true">
          <img class="tisso-header__button-arrow--black" src="{{ 'black-arrow.svg' | asset_url }}" width="27" height="12" alt="">
          <img class="tisso-header__button-arrow--white" src="{{ 'white-arrow.svg' | asset_url }}" width="27" height="12" alt="">
        </span>
      </a>
    {% else %}
      <button type="button" class="tisso-header__button tisso-header__mobile-button">
        <span class="tisso-header__button-text">{{ button_text }}</span>
        <span class="tisso-header__button-arrow" aria-hidden="true">
          <img class="tisso-header__button-arrow--black" src="{{ 'black-arrow.svg' | asset_url }}" width="27" height="12" alt="">
          <img class="tisso-header__button-arrow--white" src="{{ 'white-arrow.svg' | asset_url }}" width="27" height="12" alt="">
        </span>
      </button>
    {% endif %}
  </div>
</section>

<style>
  #tisso-header-{{ section.id }} {
    width: 100%;
    height: var(--header-height);
    background: var(--header-bg);
    color: var(--text-color);
    position: relative;
    z-index: 100;
  }

  #tisso-header-{{ section.id }} *,
  #tisso-header-{{ section.id }} *::before,
  #tisso-header-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #tisso-header-{{ section.id }} .tisso-header__inner {
    width: 100%;
    height: 100%;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    padding: 0 var(--header-padding);
  }

  /* =========================
     LOGO
  ========================= */

  #tisso-header-{{ section.id }} .tisso-header__logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  #tisso-header-{{ section.id }} .tisso-header__logo-link {
    display: inline-flex;
    align-items: center;

    text-decoration: none;
    color: inherit;
  }

  #tisso-header-{{ section.id }} .tisso-header__logo-image {
    display: block;
    width: var(--logo-width);
    height: auto;
  }

  #tisso-header-{{ section.id }} .tisso-header__text-logo {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 17px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.8px;

    color: var(--text-color);
    text-decoration: none;
  }

  /* =========================
     CENTER MESSAGE
  ========================= */

  #tisso-header-{{ section.id }} .tisso-header__message {
    font-family: var(--message-font);

    font-size: 16px;
    line-height: 1.2;
    font-weight: 400;

    text-align: center;
    white-space: nowrap;

    color: var(--text-color);
  }

  /* =========================
     BUTTON CONTAINER
  ========================= */

  #tisso-header-{{ section.id }} .tisso-header__action {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  #tisso-header-{{ section.id }} .tisso-header__menu-toggle,
  #tisso-header-{{ section.id }} .tisso-header__mobile-panel {
    display: none;
  }

  /* =========================
     BUTTON
  ========================= */

  #tisso-header-{{ section.id }} .tisso-header__button {
    position: relative;

    width: var(--button-width);
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 14px 0 18px;

    overflow: hidden;

    border: 0;
    border-radius: 0;

    background: var(--button-bg);
    color: var(--button-text);

    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    font-weight: 500;

    text-decoration: none;
    cursor: pointer;

    isolation: isolate;
  }

  /*
    Animated background layer.

    Starts completely outside the left side.
    On hover it moves from left → right.
  */
  #tisso-header-{{ section.id }} .tisso-header__button::before {
    content: "";

    position: absolute;
    z-index: -1;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    background: var(--button-hover-bg);

    transform: translateX(-100%);

    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }

  #tisso-header-{{ section.id }} .tisso-header__button:hover::before {
    transform: translateX(0);
  }

  #tisso-header-{{ section.id }} .tisso-header__button-text,
  #tisso-header-{{ section.id }} .tisso-header__button-arrow {
    position: relative;
    z-index: 2;

    transition:
      color 0.25s ease,
      transform 0.35s ease;
  }

  #tisso-header-{{ section.id }} .tisso-header__button-text {
    color: var(--button-text);
  }

  #tisso-header-{{ section.id }} .tisso-header__button-arrow {
    color: var(--button-text);
    display: grid;
    width: 27px;
    height: 12px;
    place-items: center;
  }

  #tisso-header-{{ section.id }} .tisso-header__button-arrow img {
    grid-area: 1 / 1;
    transition: opacity 0.2s ease;
  }

  #tisso-header-{{ section.id }} .tisso-header__button-arrow--white {
    opacity: 0;
  }

  #tisso-header-{{ section.id }} .tisso-header__button:hover .tisso-header__button-arrow--black {
    opacity: 0;
  }

  #tisso-header-{{ section.id }} .tisso-header__button:hover .tisso-header__button-arrow--white {
    opacity: 1;
  }

  /*
    Text + arrow become white
  */
  #tisso-header-{{ section.id }} .tisso-header__button:hover .tisso-header__button-text,
  #tisso-header-{{ section.id }} .tisso-header__button:hover .tisso-header__button-arrow {
    color: var(--button-hover-text);
  }

  /*
    Small arrow movement on hover
  */
  #tisso-header-{{ section.id }} .tisso-header__button:hover .tisso-header__button-arrow {
    transform: translateX(3px);
  }

  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 749px) {

    #tisso-header-{{ section.id }} {
      height: auto;
      min-height: var(--header-height);
    }

    #tisso-header-{{ section.id }} .tisso-header__inner {
      min-height: var(--header-height);

      grid-template-columns: auto 1fr auto;

      padding-left: 12px;
      padding-right: 12px;
      gap: 12px;
    }

    #tisso-header-{{ section.id }} .tisso-header__message {
      font-size: 16px;
      white-space: normal;
      line-height: 1.2;
    }

    #tisso-header-{{ section.id }} .tisso-header__text-logo {
      font-size: 13px;
      letter-spacing: 0.5px;
    }

    #tisso-header-{{ section.id }} .tisso-header__logo-image {
      width: min(var(--logo-width), 110px);
    }

    #tisso-header-{{ section.id }} .tisso-header__button {
      width: auto;
      min-width: 110px;
      height: 44px;

      padding-left: 12px;
      padding-right: 10px;

      font-size: 10px;
    }
  }
</style>

<style>
  @media screen and (max-width: 749px) {
    #tisso-header-{{ section.id }} { height: 40px; min-height: 40px; }
    #tisso-header-{{ section.id }} .tisso-header__inner { position: relative; min-height: 40px; display: flex; justify-content: center; padding: 0 12px; }
    #tisso-header-{{ section.id }} .tisso-header__message, #tisso-header-{{ section.id }} .tisso-header__action { display: none; }
    #tisso-header-{{ section.id }} .tisso-header__logo-image { width: min(var(--logo-width), 92px); }
    #tisso-header-{{ section.id }} .tisso-header__menu-toggle { position: absolute; top: 50%; left: 10px; display: grid; width: 18px; height: 18px; padding: 3px 0; transform: translateY(-50%); border: 0; background: transparent; cursor: pointer; }
    #tisso-header-{{ section.id }} .tisso-header__menu-toggle span { display: block; width: 13px; height: 1px; background: #111; }
    #tisso-header-{{ section.id }} .tisso-header__mobile-panel:not([hidden]) { position: absolute; z-index: 101; top: 44px; left: 0; display: flex; width: 100%; flex-direction: column; align-items: center; padding: 0 0 16px; background: #f5f5f5; box-shadow: 0 4px 8px rgb(0 0 0 / 10%); }
    #tisso-header-{{ section.id }} .tisso-header__mobile-panel-bar { position: relative; display: flex; width: 100%; height: 46px; align-items: center; justify-content: center; background: #fff; border-bottom: 1px solid #e2e2e2; font: 500 16px/1 'Jost', Arial, sans-serif; }
    #tisso-header-{{ section.id }} .tisso-header__mobile-close { position: absolute; left: 10px; border: 0; background: transparent; color: #111; font: 300 22px/1 Arial, sans-serif; cursor: pointer; }
    #tisso-header-{{ section.id }} .tisso-header__mobile-panel p { margin: 14px 0 10px; font: 400 10px/1.2 'Jost', Arial, sans-serif; }
    #tisso-header-{{ section.id }} .tisso-header__mobile-button { width: 135px; height: 28px; padding: 0 12px 0 16px; background: #fff200; color: #111; font-size: 10px; }
    #tisso-header-{{ section.id }} .tisso-header__mobile-button :is(.tisso-header__button-text, .tisso-header__button-arrow) { color: #111; }
  }
</style>

<script>
  (() => {
    const header = document.getElementById('tisso-header-{{ section.id }}');
    if (!header || header.dataset.mobileMenuReady) return;
    header.dataset.mobileMenuReady = 'true';
    const toggle = header.querySelector('[data-tisso-menu-toggle]');
    const panel = header.querySelector('[data-tisso-mobile-panel]');
    const close = header.querySelector('[data-tisso-menu-close]');
    const setOpen = (open) => { panel.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    close.addEventListener('click', () => setOpen(false));
  })();
</script>

{% schema %}
{
  "name": "Tisso Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 250,
      "step": 5,
      "unit": "px",
      "default": 120
    },

    {
      "type": "header",
      "content": "Message"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Message",
      "default": "Find the ideal gift for your loved ones."
    },

    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Button width",
      "min": 150,
      "max": 250,
      "step": 1,
      "unit": "px",
      "default": 207
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#FFF200"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Tisso Header"
    }
  ]
}
{% endschema %}
