{% liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign hero_image = desktop_image

  if mobile_image == blank
    assign mobile_image = desktop_image
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

<section
  id="custom-hero-{{ section.id }}"
  class="custom-hero-section"
  style="
    --hero-min-height: {{ section.settings.hero_height }}px;
    --hero-footer-height: {{ section.settings.footer_bar_height }}px;
    --hero-heading-size: {{ section.settings.heading_size }}px;
    --hero-description-size: {{ section.settings.description_size }}px;
    --hero-button-width: {{ section.settings.button_width }}px;
    --hero-button-height: {{ section.settings.button_height }}px;
    --hero-footer-bg: {{ section.settings.footer_bar_background }};
    --hero-footer-text-size: {{ section.settings.footer_bar_text_size }}px;
    --hero-content-width: {{ section.settings.content_max_width }}px;
    --hero-content-top: {{ section.settings.content_top_padding }}px;
    --hero-content-bottom: {{ section.settings.content_bottom_padding }}px;
    --hero-content-left: {{ section.settings.content_left_padding }}px;
    --hero-content-right: {{ section.settings.content_right_padding }}px;
    --hero-desktop-position-x: {{ section.settings.desktop_image_position_x }}%;
    --hero-desktop-position-y: {{ section.settings.desktop_image_position_y }}%;
    --hero-mobile-position-x: {{ section.settings.mobile_image_position_x }}%;
    --hero-mobile-position-y: {{ section.settings.mobile_image_position_y }}%;
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-heading-color: {{ section.settings.heading_color }};
    --hero-text-color: {{ section.settings.text_color }};
    --hero-note-color: {{ section.settings.note_color }};
    --hero-button-bg: {{ section.settings.button_background }};
    --hero-button-text: {{ section.settings.button_text_color }};
    --hero-button-hover-bg: {{ section.settings.button_hover_background }};
    --hero-button-hover-text: {{ section.settings.button_hover_text_color }};
    --hero-section-bg: {{ section.settings.section_background }};
    --hero-card-bg: {{ section.settings.content_background | color_modify: 'alpha', section.settings.content_background_opacity | divided_by: 100.0 }};
    --hero-card-border: {{ section.settings.content_border_color | color_modify: 'alpha', section.settings.content_border_opacity | divided_by: 100.0 }};
  "
>
  <div class="custom-hero">
    <div class="custom-hero__media">
      {% if hero_image != blank %}
        <picture>
          {% if mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 480 }} 480w,
                {{ mobile_image | image_url: width: 768 }} 768w,
                {{ mobile_image | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
              width="{{ mobile_image.width }}"
              height="{{ mobile_image.height }}"
            >
          {% endif %}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              widths: '768, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              class: 'custom-hero__image',
              alt: hero_image.alt | default: section.settings.heading,
              fetchpriority: fetch_priority
          }}
        </picture>
      {% else %}
        <img
          src="{{ 'group-1000008197.svg' | asset_url }}"
          class="custom-hero__image"
          width="1440"
          height="780"
          alt="{{ section.settings.heading | escape }}"
          fetchpriority="{{ fetch_priority }}"
        >
      {% endif %}
      <div class="custom-hero__overlay"></div>
    </div>

    <div class="custom-hero__content-wrap">
      <div class="custom-hero__content">
        {% if section.settings.heading != blank %}
          <h2 class="custom-hero__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="custom-hero__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          {% if section.settings.button_link != blank %}
            <a
              href="{{ section.settings.button_link }}"
              class="custom-hero__button"
            >
              <span class="custom-hero__button-text">{{ section.settings.button_label }}</span>
              <span aria-hidden="true" class="custom-hero__button-arrow">→</span>
            </a>
          {% else %}
            <span class="custom-hero__button custom-hero__button--disabled">
              <span class="custom-hero__button-text">{{ section.settings.button_label }}</span>
              <span aria-hidden="true" class="custom-hero__button-arrow">→</span>
            </span>
          {% endif %}
        {% endif %}
      </div>
    </div>

    {% if section.settings.footer_note != blank %}
      <div class="custom-hero__footer-note">
        {{ section.settings.footer_note }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #custom-hero-{{ section.id }} {
    background: var(--hero-section-bg);
  }

  #custom-hero-{{ section.id }} *,
  #custom-hero-{{ section.id }} *::before,
  #custom-hero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #custom-hero-{{ section.id }} .custom-hero {
    position: relative;
    width: 100%;
    min-height: var(--hero-min-height);
    overflow: hidden;
    background: var(--hero-section-bg);
  }

  #custom-hero-{{ section.id }} .custom-hero__media,
  #custom-hero-{{ section.id }} .custom-hero__media picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  #custom-hero-{{ section.id }} .custom-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-desktop-position-x) var(--hero-desktop-position-y);
    display: block;
  }

  #custom-hero-{{ section.id }} .custom-hero__image--placeholder {
    width: 100%;
    height: 100%;
    fill: currentColor;
    color: #d9d9d9;
    background: #f5f5f5;
  }

  #custom-hero-{{ section.id }} .custom-hero__overlay {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: var(--hero-overlay-opacity);
    pointer-events: none;
  }

  #custom-hero-{{ section.id }} .custom-hero__content-wrap {
    position: relative;
    z-index: 1;
    min-height: var(--hero-min-height);
    display: flex;
    align-items: flex-end;
    padding:
      var(--hero-content-top)
      var(--hero-content-right)
      var(--hero-content-bottom)
      var(--hero-content-left);
  }

  #custom-hero-{{ section.id }} .custom-hero__content {
    max-width: var(--hero-content-width);
    width: 100%;
    background: var(--hero-card-bg);
    border: 1px solid var(--hero-card-border);
    padding: 0;
  }

  #custom-hero-{{ section.id }} .custom-hero__heading {
    margin: 0 0 28px;
    color: var(--hero-heading-color);
    font-family: Arial, Helvetica, sans-serif;
    font-size: var(--hero-heading-size);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  #custom-hero-{{ section.id }} .custom-hero__description {
    margin: 0 0 34px;
    color: var(--hero-text-color);
    font-family: Arial, Helvetica, sans-serif;
    font-size: var(--hero-description-size);
    line-height: 1.55;
    font-weight: 400;
    max-width: 32rem;
  }

  #custom-hero-{{ section.id }} .custom-hero__description > *:first-child {
    margin-top: 0;
  }

  #custom-hero-{{ section.id }} .custom-hero__description > *:last-child {
    margin-bottom: 0;
  }

  #custom-hero-{{ section.id }} .custom-hero__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    width: var(--hero-button-width);
    min-height: var(--hero-button-height);
    justify-content: space-between;
    padding: 0 26px;
    overflow: hidden;
    border: 0;
    background: var(--hero-button-bg);
    color: var(--hero-button-text);
    text-decoration: none;
    text-transform: uppercase;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.08em;
    cursor: pointer;
    isolation: isolate;
  }

  #custom-hero-{{ section.id }} .custom-hero__button::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    background: var(--hero-button-hover-bg);
    transform: translateX(-100%);
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }

  #custom-hero-{{ section.id }} .custom-hero__button:hover::before {
    transform: translateX(0);
  }

  #custom-hero-{{ section.id }} .custom-hero__button-text,
  #custom-hero-{{ section.id }} .custom-hero__button-arrow {
    position: relative;
    z-index: 1;
    transition:
      color 0.25s ease,
      transform 0.35s ease;
  }

  #custom-hero-{{ section.id }} .custom-hero__button-text,
  #custom-hero-{{ section.id }} .custom-hero__button-arrow {
    color: var(--hero-button-text);
  }

  #custom-hero-{{ section.id }} .custom-hero__button:hover .custom-hero__button-text,
  #custom-hero-{{ section.id }} .custom-hero__button:hover .custom-hero__button-arrow {
    color: var(--hero-button-hover-text);
  }

  #custom-hero-{{ section.id }} .custom-hero__button--disabled {
    cursor: default;
  }

  #custom-hero-{{ section.id }} .custom-hero__button-arrow {
    font-size: 1.25rem;
    line-height: 1;
  }

  #custom-hero-{{ section.id }} .custom-hero__button:hover .custom-hero__button-arrow {
    transform: translateX(3px);
  }

  #custom-hero-{{ section.id }} .custom-hero__footer-note {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 1;
    transform: translateX(-50%);
    width: 100%;
    min-height: var(--hero-footer-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    color: var(--hero-note-color);
    background: var(--hero-footer-bg);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: Arial, Helvetica, sans-serif;
    font-size: var(--hero-footer-text-size);
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    #custom-hero-{{ section.id }} .custom-hero {
      min-height: auto;
    }

    #custom-hero-{{ section.id }} .custom-hero__image {
      object-position: var(--hero-mobile-position-x) var(--hero-mobile-position-y);
    }

    #custom-hero-{{ section.id }} .custom-hero__content-wrap {
      min-height: {{ section.settings.mobile_hero_height }}px;
      padding:
        {{ section.settings.mobile_content_top_padding }}px
        {{ section.settings.mobile_content_side_padding }}px
        {{ section.settings.mobile_content_bottom_padding }}px;
      align-items: flex-end;
    }

    #custom-hero-{{ section.id }} .custom-hero__content {
      max-width: 100%;
    }

    #custom-hero-{{ section.id }} .custom-hero__heading {
      margin-bottom: 18px;
      font-size: clamp(2.125rem, 12vw, 3rem);
    }

    #custom-hero-{{ section.id }} .custom-hero__description {
      margin-bottom: 26px;
      font-size: 1rem;
      line-height: 1.45;
    }

    #custom-hero-{{ section.id }} .custom-hero__button {
      min-height: 50px;
      padding-inline: 20px;
      gap: 14px;
      font-size: 0.75rem;
    }

    #custom-hero-{{ section.id }} .custom-hero__footer-note {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      margin-top: -1px;
    }
  }
</style>

{% schema %}
